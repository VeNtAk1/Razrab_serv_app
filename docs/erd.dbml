// ============ USERS ============
Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  role varchar(20) [not null, note: 'BUYER | SELLER | ADMIN']
  display_name varchar(120) [not null]
  is_blocked boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    email [unique]
    role
  }
}

// ============ PRODUCTS ============
Table products {
  id uuid [pk, default: `gen_random_uuid()`]
  seller_id uuid [not null, ref: > users.id]
  title varchar(200) [not null]
  description text
  price numeric(12,2) [not null, check: `price >= 0`]
  currency char(3) [not null, default: 'RUB']
  file_key varchar(500) [not null, note: 'S3 object key']
  file_size_bytes bigint [not null, check: `file_size_bytes > 0`]
  status varchar(20) [not null, default: 'DRAFT', note: 'DRAFT | PENDING | ACTIVE | REJECTED | ARCHIVED']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    seller_id
    status
    (status, created_at)
  }
}

// ============ COMMISSION RATES ============
Table commission_rates {
  id uuid [pk, default: `gen_random_uuid()`]
  percent numeric(5,2) [not null, check: `percent >= 0 and percent <= 100`]
  is_active boolean [not null, default: true]
  valid_from timestamptz [not null, default: `now()`]
  valid_to timestamptz [note: 'NULL = бессрочно']
  created_by uuid [ref: > users.id]

  indexes {
    is_active
    valid_from
  }
}

// ============ ORDERS ============
Table orders {
  id uuid [pk, default: `gen_random_uuid()`]
  buyer_id uuid [not null, ref: > users.id]
  product_id uuid [not null, ref: > products.id]
  seller_id uuid [not null, ref: > users.id]
  amount numeric(12,2) [not null, check: `amount >= 0`]
  commission_percent numeric(5,2) [not null, check: `commission_percent >= 0`]
  commission_amount numeric(12,2) [not null, check: `commission_amount >= 0`]
  seller_payout numeric(12,2) [not null, check: `seller_payout >= 0`]
  currency char(3) [not null, default: 'RUB']
  status varchar(20) [not null, default: 'PENDING', note: 'PENDING | PAID | REFUNDED | FAILED']
  payment_provider_id varchar(255) [unique, note: 'ID транзакции у провайдера']
  created_at timestamptz [not null, default: `now()`]
  paid_at timestamptz

  indexes {
    buyer_id
    product_id
    seller_id
    status
    (seller_id, status)
    created_at
  }
}

// ============ DOWNLOAD TOKENS ============
Table download_tokens {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid [not null, ref: > orders.id]
  token_hash varchar(128) [not null, unique, note: 'SHA-256 от секретного токена']
  expires_at timestamptz [not null]
  max_downloads int [not null, default: 1, check: `max_downloads > 0`]
  downloads_count int [not null, default: 0, check: `downloads_count >= 0`]
  is_revoked boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  last_used_at timestamptz

  indexes {
    order_id
    token_hash [unique]
    expires_at
  }
}

// ============ PAYOUTS ============
Table payouts {
  id uuid [pk, default: `gen_random_uuid()`]
  seller_id uuid [not null, ref: > users.id]
  amount numeric(12,2) [not null, check: `amount > 0`]
  status varchar(20) [not null, default: 'REQUESTED', note: 'REQUESTED | PROCESSING | PAID | REJECTED']
  requested_at timestamptz [not null, default: `now()`]
  processed_at timestamptz

  indexes {
    seller_id
    status
  }
}

// ============ REVIEWS ============
Table reviews {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid [not null, unique, ref: > orders.id]
  product_id uuid [not null, ref: > products.id]
  buyer_id uuid [not null, ref: > users.id]
  rating int [not null, check: `rating between 1 and 5`]
  comment text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    product_id
    buyer_id
  }
}

// ============ AUDIT LOG ============
Table audit_log {
  id uuid [pk, default: `gen_random_uuid()`]
  actor_id uuid [ref: > users.id]
  action varchar(80) [not null]
  entity_type varchar(50) [not null]
  entity_id uuid [not null]
  payload jsonb
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (entity_type, entity_id)
    actor_id
    created_at
  }
}
